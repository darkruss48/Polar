<RCC>
    <qresource prefix="/images">
        <file alias="en_US.png">resources/images/en_US.png</file>
        <file alias="fr_FR.png">resources/images/fr_FR.png</file>
        <file alias="es_ES.png">resources/images/es_ES.png</file>
        <file alias="it_IT.png">resources/images/it_IT.png</file>
        <file alias="image.png">resources/images/image.png</file>
        <file alias="settings_icon.png">resources/images/settings_icon.png</file>
        <file alias="medal.png">resources/images/medal.png</file>
        <file alias="chart.png">resources/images/chart.png</file>
        <file alias="guy.png">resources/images/guy.png</file>
    </qresource>
    <qresource prefix="/">
        <!-- Other resources -->
        <file alias="mainwindow.ui">ui/mainwindow.ui</file>
        <!-- NEW: classement page -->
        <file alias="classement.ui">ui/classement.ui</file>
        <!-- NEW: options dialog -->
        <file alias="options.ui">ui/options.ui</file>
        <file alias="joueur.ui">ui/joueur.ui</file>
    </qresource>
</RCC>
